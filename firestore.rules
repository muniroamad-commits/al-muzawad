rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function papelDoUtilizador() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('papel', 'admin');
    }

    function isAdminCompleto() {
      return isAdmin() && papelDoUtilizador() == 'admin';
    }

    function isOwner(clienteId) {
      return request.auth != null && request.auth.uid == clienteId;
    }

    // Catálogo: qualquer visitante pode ler (loja pública).
    // Só administradores completos (não operadores) podem escrever.
    match /categorias/{id} {
      allow read: if true;
      allow write: if isAdminCompleto();
    }

    match /produtos/{id} {
      allow read: if true;
      allow write: if isAdminCompleto();
    }

    // Perfis de admin: qualquer membro da equipa lê o seu próprio documento
    // (para confirmar sessão e papel); só administradores completos podem
    // ver a lista toda e registar/remover colaboradores.
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdminCompleto());
      allow list: if isAdminCompleto();
      allow create: if isAdminCompleto();
      allow update: if false;
      allow delete: if isAdminCompleto();
    }

    // Perfis de cliente: o próprio cliente lê/escreve o seu perfil; qualquer
    // membro da equipa (admin ou operador) pode ler para dar apoio ao cliente.
    match /clientes/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Encomendas: cliente cria as suas próprias e só lê as suas;
    // qualquer membro da equipa (admin ou operador) lê e actualiza todas
    // — é o "atendimento" que o operador faz.
    match /encomendas/{id} {
      allow create: if request.auth != null &&
        request.resource.data.cliente_id == request.auth.uid;
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.cliente_id == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
